# --- Django migrations (compiled files only — real .py migrations stay tracked) ---
BackEnd/**/migrations/__pycache__/
BackEnd/**/migrations/*.py[cod]
BackEnd/**/local_settings.py

# --- Frontend (Vite/React) ---
FrontEnd/node_modules/
FrontEnd/dist/
FrontEnd/build/
FrontEnd/.vite/
FrontEnd/.env
FrontEnd/.env.*
FrontEnd/*.local

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
*.sublime-workspace
*.sublime-project
*.swp
*.swo
*.bak
*.orig

# --- Logs / coverage / caches ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
*.cover
coverage.*
*.cache
*.tmp
*.temp

# --- If you ever run collectstatic ---
staticfiles/