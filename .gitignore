# --- Environment / secrets ---
.env
.env.*
Agent/Config/.env
confidentials.yml
Agent/src/agent/confidentials.yml

# --- Database ---
db.sqlite3
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
venv/
.venv/
ENV/
python-env/
